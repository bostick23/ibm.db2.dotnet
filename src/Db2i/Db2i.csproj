<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Db2i</AssemblyName>
    <RootNamespace>Db2i</RootNamespace>
    <PackageId>Db2i</PackageId>
    <Version>0.5.0-alpha.2</Version>
    <Authors>Db2i contributors</Authors>
    <Copyright>Copyright (c) 2026 Db2i contributors.</Copyright>
    <Title>Db2i</Title>
    <Description>An open-source ADO.NET provider for Db2 for IBM i.</Description>
    <PackageLicenseExpression>IPL-1.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>db2;ibm-i;iseries;as400;ado.net;database</PackageTags>
    <PackageProjectUrl>https://github.com/bostick23/ibm.db2.dotnet</PackageProjectUrl>
    <PackageReleaseNotes>Documentation-only follow-up to 0.5.0-alpha.1. All public documentation and the NuGet README are now in English; provider behavior is unchanged.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/bostick23/ibm.db2.dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
