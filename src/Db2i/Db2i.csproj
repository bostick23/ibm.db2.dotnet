<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Db2i</AssemblyName>
    <RootNamespace>Db2i</RootNamespace>
    <PackageId>Db2i</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>An open source ADO.NET provider for Db2 for IBM i.</Description>
    <PackageLicenseExpression>IPL-1.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>db2;ibm-i;iseries;as400;ado.net;database</PackageTags>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
